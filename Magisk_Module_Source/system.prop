# Android 13+ framework spatializer gate used by AudioService.
ro.audio.spatializer_enabled=true
ro.spatializer.supported=true
ro.spatializer.pose_predictor_type=0

# Dolby DAP / ds2 flags (verified working on-device in v1: DlbDap2Process
# counters increment and hardbypass stays false through boot).
vendor.audio.dolby.ds2.enabled=true
vendor.audio.dolby.ds2.hardbypass=false
ro.vendor.audio.spatializer.enabled=true
