# Android 13+ framework spatializer gate used by AudioService.
ro.audio.spatializer_enabled=true

# Pong hardware_dolby defaults. DAP is controlled through the AudioEffect API;
# ds2.enabled is deliberately false in the upstream port.
ro.audio.spatializer_transaural_enabled_default=false
vendor.audio.dolby.ds2.enabled=false
vendor.audio.dolby.ds2.hardbypass=false
